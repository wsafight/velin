{
  "name": "vscode-velin",
  "displayName": "Velin",
  "description": "Syntax highlighting and language support for the Velin scripting language, backed by velin-lsp.",
  "version": "0.5.1",
  "license": "MIT",
  "publisher": "velin",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsafight/velin"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:velin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "velin",
        "aliases": [
          "Velin",
          "velin"
        ],
        "extensions": [
          ".velin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velin",
        "scopeName": "source.velin",
        "path": "./syntaxes/velin.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Velin",
      "properties": {
        "velin.server.path": {
          "type": "string",
          "default": "",
          "description": "Optional path to a velin-lsp executable. Release packages use their bundled server by default; development installs fall back to velin-lsp on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.9"
  },
  "scripts": {
    "build": "esbuild src/extension.js --bundle --external:vscode --platform=node --format=cjs --outfile=dist/extension.js",
    "check": "node --check src/extension.js && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  }
}
