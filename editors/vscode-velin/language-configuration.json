{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:export\\s+)?(label|fn|if|elif|else|while|for)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(elif|else)\\b.*:\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:export\\s+)?(label|fn|if|elif|else|while|for)\\b.*:\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
